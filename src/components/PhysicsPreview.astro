---
// Compact version of panel (a) from the author's MethodOverview.astro.
// Retains original scene/trajectory artwork and animated information flow.
---
<svg class="physics-preview" viewBox="0 0 360 344" role="img" aria-label="Uncalibrated world model: the same test scene and actions can lead to different possible futures when physical dynamics are unknown.">
  <defs>
    <marker id="physics-preview-arrow" markerWidth="6" markerHeight="6" refX="5" refY="3" orient="auto" markerUnits="strokeWidth"><path d="M0 0L6 3L0 6Z" fill="#a3a3a3" /></marker>
  </defs>
  <rect x="2" y="7" width="100" height="114" rx="15" fill="#fceced" />
  <rect x="10" y="15" width="84" height="83" rx="9" fill="white" stroke="#d7d7d7" stroke-width="2" />
  <image href="/physicalworld-diagram/test-scene.png" x="14" y="19" width="76" height="75" />
  <text x="52" y="114">Test scene</text>
  <rect x="127" y="29" width="106" height="78" rx="14" fill="#dbeaf8" />
  <text x="180" y="63">World</text><text x="180" y="84">Model</text>
  <rect x="258" y="7" width="100" height="114" rx="15" fill="#fce3d5" />
  <image href="/physicalworld-diagram/icon-actions.svg" x="274" y="15" width="68" height="76" />
  <text x="308" y="114">Actions</text>
  <g class="flow" fill="none" stroke="#a3a3a3" stroke-width="2.8" stroke-dasharray="3 3" marker-end="url(#physics-preview-arrow)">
    <path d="M103 70H123" /><path d="M257 70H237" /><path d="M180 111V145" />
  </g>
  <rect x="2" y="151" width="356" height="155" rx="16" fill="#efefef" />
  <text x="167" y="176">Physical dynamics</text><text class="question" x="272" y="177" fill="#d90000">?</text>
  {[1, 2, 3].map((n) => (
    <g class="future" style={`--delay:${(n - 1) * 0.45}s`}>
      <rect x={13 + (n - 1) * 116} y="190" width="102" height="84" rx="9" fill="white" stroke="#d7d7d7" stroke-width="2" />
      <image href={`/physicalworld-diagram/a-future-${n}.png`} x={22 + (n - 1) * 116} y="194" width="84" height="76" />
    </g>
  ))}
  <text class="small" x="180" y="295">Same actions · different possible futures</text>
  <text class="caption" x="180" y="332">Uncalibrated world model</text>
</svg>
<style>
  .physics-preview { display: block; width: 100%; height: auto; }
  text { font-family: Arial, sans-serif; font-size: 17px; text-anchor: middle; fill: #222; }
  .small { font-size: 12px; }
  .caption { font-size: 14px; fill: #62625e; }
  .question { fill: #d90000; font-size: 26px; }
  .flow { animation: flow 1s linear infinite; }
  .future { animation: reveal 5s ease-in-out infinite; animation-delay: var(--delay); }
  @keyframes flow { to { stroke-dashoffset: -12; } }
  @keyframes reveal { 0%, 12% { opacity: .3; } 28%, 85% { opacity: 1; } 100% { opacity: .3; } }
  @media (prefers-reduced-motion: reduce) { .flow, .future { animation: none; } }
</style>
