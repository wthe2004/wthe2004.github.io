---
import { execFileSync } from 'node:child_process';
import { profile, publications } from '../data/profile';
import '../styles/global.css';
import { Image } from 'astro:assets';
import avatar from '../assets/avatar.jpg';
import PhysicsPreview from '../components/PhysicsPreview.astro';
import boldFont from '@fontsource/ibm-plex-mono/files/ibm-plex-mono-latin-700-normal.woff2?url';
import regularFont from '@fontsource/ibm-plex-mono/files/ibm-plex-mono-latin-400-normal.woff2?url';

// Runs on the server in development and at build time for the static site.
let lastUpdated: { iso: string; label: string } | undefined;
try {
  const iso = execFileSync('git', ['log', '-1', '--format=%cI'], {
    cwd: process.cwd(),
    encoding: 'utf8',
    stdio: ['ignore', 'pipe', 'pipe'],
  }).trim();
  const date = new Date(iso);
  if (!Number.isNaN(date.getTime())) {
    lastUpdated = {
      iso,
      label: new Intl.DateTimeFormat('en-US', {
        month: 'long', year: 'numeric', timeZone: 'America/Detroit',
      }).format(date),
    };
  }
} catch {
  // Source archives may lack Git metadata; omit the date rather than invent one.
  console.warn('Last updated omitted: Git commit metadata is unavailable.');
}
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={profile.description} />
    <meta name="theme-color" content="#f7f7f5" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preload" href={regularFont} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={boldFont} as="font" type="font/woff2" crossorigin />
    <title>{profile.name}</title>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <div class="page">
      <main id="main">
        <section class="about" id="about" aria-labelledby="name">
          <div class="profile-heading">
          <div>
          <h1 id="name">{profile.name}<span class="caret" aria-hidden="true"></span></h1>
          <p class="affiliation">{profile.role}<span class="separator" aria-hidden="true"> / </span>{profile.affiliation}</p>

          </div>
          <Image class="avatar" src={avatar} alt={`Portrait of ${profile.name}`} width={210} height={210} widths={[128, 210, 256, 420]} sizes="(max-width: 600px) 128px, 210px" loading="eager" />
          </div>

          <div class="biography">
            {profile.introduction.map((paragraph) => (
              <p>{paragraph.map((segment) => segment.href
                ? <a href={segment.href}>{segment.text}</a>
                : segment.text)}</p>
            ))}
          </div>

          <ul class="profile-links" aria-label="Profile links">
            {profile.links.filter((link) => link.href).map((link) => (
              <li><a href={link.href}>{link.label}<span class="link-arrow" aria-hidden="true">↗</span></a></li>
            ))}
          </ul>
        </section>

        <section class="research" id="research" aria-labelledby="research-heading">
          <div class="section-heading">
            <h2 id="research-heading">Publications &amp; Preprints</h2>
          </div>
          <ol class="publications">
            {publications.map((paper) => (
              <li class="publication">

                <article>
                  <h3><a href={paper.titleHref}>{paper.title}</a></h3>
                  <p class="authors">{paper.authors.map((author, authorIndex) => (
                    <>{authorIndex > 0 && ', '}{author === profile.name ? <strong>{author}</strong> : author}{paper.authorMarks?.[author] && <sup>{paper.authorMarks[author]}</sup>}</>
                  ))}</p>
                  {paper.authorNote && <p class="author-note">{paper.authorNote}</p>}
                  <div class="paper-meta">
                    <span class="venue">{paper.venue}{paper.year && <>, {paper.year}</>}</span>
                    {paper.links.map((link) => (
                      <><span class="meta-dot" aria-hidden="true">·</span><a href={link.href}>{link.label}</a></>
                    ))}
                  </div>
                  <p class="paper-description">{paper.description}</p>
                </article>
                <a class="paper-thumbnail" href={paper.titleHref}>
                  {paper.diagram === 'physics' ? <PhysicsPreview /> : (
                  <picture>
                    {paper.animation && <source media="(prefers-reduced-motion: no-preference)" srcset={paper.animation} type="image/gif" />}
                    <Image src={paper.image} alt={paper.imageAlt} width={paper.image.width} height={paper.image.height} widths={[180, 360, 540, 720]} sizes="240px" loading="lazy" />
                  </picture>
                  )}
                </a>
              </li>
            ))}
          </ol>
        </section>
      </main>

      <footer>
        <span>{profile.name}{lastUpdated && <> · Last updated <time datetime={lastUpdated.iso}>{lastUpdated.label}</time></>}</span>
      </footer>
    </div>
  </body>
</html>
